# Milvus connection
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus

# FHIR Server connection
FHIR_BASE_URL=http://localhost:4000/hapi-fhir-jpaserver/fhir
# Comma-separated list of patient IDs to discover (leave empty to discover all)
FHIR_PATIENT_IDS=p007,p008

# LLM configuration (OpenAI-compatible API)
LLM_BASE_URL=
LLM_MODEL=google/medgemma-27b-text-it
LLM_API_KEY=

# Embedding model configuration (Ollama OpenAI-compatible API)
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=qwen3-embedding:4b-fp16
EMBEDDING_API_KEY=

# Default Fragestellung for initial keypoint extraction on startup
# Set to empty to skip startup extraction - can be run manually via /add_keypoints endpoint
DEFAULT_FRAGESTELLUNG=

# Context management settings
# Maximum tokens to send to LLM (should be less than model's context window to leave room for response)
MAX_CONTEXT_TOKENS=50000
# Maximum number of conversation messages to include in history
MAX_HISTORY_MESSAGES=20
# Maximum characters per chunk for document processing
MAX_CHUNK_CHARS=30000

# Summary generation settings
# Max retries per field when LLM output is malformed (0 = no retries)
SUMMARY_FIELD_MAX_RETRIES=3

SUMMARY_CORRECTION_LOOP_ENABLED=false
SUMMARY_CORRECTION_LOOP_PASSES=1

# SQLite database path (persisted via Docker volume)
SQLITE_DB_PATH=./data/medgemma.db

LOG_TO_FILE=false