# HAPI R4 FHIR Server
HOST=localhost
R4_ENABLED=1
R4_PORT=4000
R4_MEMORY=6g
R4_CPU_CORES=2
R4_IMAGE=smartonfhir/hapi-5:r4-empty
# FHIR viewer
FHIR_VIEWER_ENABLED=1
FHIR_VIEWER_PORT=4001
# FHIR patient browser
PATIENT_BROWSER_ENABLED=1
PATIENT_BROWSER_PORT=4002
# MCP to FHIR 
MCPFHIR_ENABLED=1
MCPFHIR_PORT=4003
